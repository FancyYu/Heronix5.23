/* pages/emotion/emotion.wxss */
.page { background: #F5F3EF; min-height: 100vh; padding-bottom: 40rpx; }
.card { background: #fff; border-radius: 24rpx; padding: 32rpx; margin: 24rpx 24rpx 0; box-shadow: 0 2rpx 16rpx rgba(61,58,54,0.07); }
.card-title { font-size: 32rpx; font-weight: 700; color: #3D3A36; margin-bottom: 16rpx; }
.card-desc { font-size: 24rpx; color: #6B6560; line-height: 1.6; margin-bottom: 24rpx; }

.emotion-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}
.emotion-card {
  text-align: center;
  padding: 24rpx 8rpx;
  border: 1rpx solid rgba(61,58,54,0.1);
  border-radius: 20rpx;
  background: #fff;
}
.emotion-card.selected { border-color: #8BA888; background: #C5D8C3; }
.emotion-emoji { font-size: 48rpx; margin-bottom: 8rpx; }
.emotion-name { font-size: 22rpx; font-weight: 600; color: #3D3A36; }

.strategy-card { margin-top: 16rpx; background: #C5D8C3 !important; }
.strategy-title { font-size: 30rpx; font-weight: 700; color: #3D3A36; margin-bottom: 20rpx; }
.strategy-list { display: flex; flex-direction: column; gap: 12rpx; }
.strategy-item {
  display: flex; align-items: flex-start; gap: 16rpx;
  padding: 20rpx 24rpx; background: #fff; border-radius: 16rpx;
}
.strategy-num {
  width: 40rpx; height: 40rpx; flex-shrink: 0;
  background: #8BA888; color: #fff; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 22rpx; font-weight: 700; margin-top: 2rpx;
}
.strategy-text { font-size: 28rpx; color: #3D3A36; line-height: 1.6; flex: 1; }
