/* pages/focus/focus.wxss */
.page { background: #F5F3EF; min-height: 100vh; padding-bottom: 40rpx; }
.timer-card { background: #fff; border-radius: 24rpx; padding: 40rpx 32rpx; margin: 24rpx 24rpx 0; box-shadow: 0 2rpx 16rpx rgba(61,58,54,0.07); }
.card-title { font-size: 32rpx; font-weight: 700; color: #3D3A36; margin-bottom: 32rpx; text-align: center; }

.timer-wrap { position: relative; width: 400rpx; height: 400rpx; margin: 0 auto 40rpx; display: flex; align-items: center; justify-content: center; }
.timer-canvas { width: 400rpx; height: 400rpx; }
.timer-center { position: absolute; text-align: center; }
.timer-time { font-size: 72rpx; font-weight: 700; color: #3D3A36; letter-spacing: -2rpx; }
.timer-label { font-size: 24rpx; color: #9B9590; margin-top: 8rpx; }

.timer-controls { display: flex; justify-content: center; gap: 20rpx; margin-bottom: 32rpx; }
.timer-btn { padding: 20rpx 48rpx !important; font-size: 28rpx !important; }

.presets { display: flex; justify-content: center; gap: 16rpx; flex-wrap: wrap; }
.preset-chip {
  padding: 12rpx 28rpx;
  border: 1rpx solid rgba(61,58,54,0.12);
  border-radius: 40rpx;
  background: #fff;
  font-size: 24rpx; color: #6B6560; font-weight: 600;
}
.preset-chip.active { background: #C4D8ED; color: #5A7FA0; border-color: #8CAFD4; }
