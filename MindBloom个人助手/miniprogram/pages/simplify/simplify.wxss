/* pages/simplify/simplify.wxss */
.page { background: #F5F3EF; min-height: 100vh; padding-bottom: 40rpx; }
.card { background: #fff; border-radius: 24rpx; padding: 32rpx; margin: 24rpx 24rpx 0; box-shadow: 0 2rpx 16rpx rgba(61,58,54,0.07); }
.card-title { font-size: 32rpx; font-weight: 700; color: #3D3A36; margin-bottom: 16rpx; }
.card-desc { font-size: 24rpx; color: #6B6560; line-height: 1.6; margin-bottom: 24rpx; }

.section-label { font-size: 22rpx; font-weight: 600; color: #9B9590; text-transform: uppercase; letter-spacing: 2rpx; margin-bottom: 12rpx; }
.result-label { margin-top: 32rpx; }

.text-area {
  width: 100%; background: #EDEAE4; border-radius: 16rpx;
  padding: 24rpx; font-size: 28rpx; color: #3D3A36; line-height: 1.8;
  min-height: 200rpx;
}

.action-row { display: flex; gap: 16rpx; margin-top: 24rpx; }
.btn-lavender {
  background: #A89BC5; color: #fff; border-radius: 16rpx;
  padding: 20rpx 40rpx; font-size: 28rpx; font-weight: 600;
}
.lavender-outline {
  background: transparent; color: #A89BC5; border: 1rpx solid #A89BC5;
  border-radius: 16rpx; padding: 20rpx 40rpx; font-size: 28rpx; font-weight: 600;
}

.result-box {
  background: #D4CCE8; border-radius: 16rpx; padding: 24rpx;
  font-size: 28rpx; color: #3D3A36; line-height: 1.8;
}
.copy-btn {
  margin-top: 16rpx; text-align: center;
  font-size: 26rpx; color: #A89BC5; font-weight: 600;
}
